# Copy to .env, or let `sh install.sh` write it. Nothing here is committed.

# Anthropic API key used by the Strands agent (agent.py).
ANTHROPIC_API_KEY=

# Infrahub, as started by install.sh (also read by infrahub-mcp and infrahubctl).
INFRAHUB_ADDRESS=http://localhost:8000
# API token the agent, infrahubctl and infrahub-mcp use: the initial admin token below.
INFRAHUB_API_TOKEN=
# Secrets of the Infrahub Compose stack; install.sh generates them so the defaults of the public compose file are never used.
INFRAHUB_INITIAL_ADMIN_TOKEN=
INFRAHUB_INITIAL_AGENT_TOKEN=
INFRAHUB_SECURITY_SECRET_KEY=

# Git repository Infrahub clones (read-only) for the query, the template and the artifact definition. Change for a fork.
INFRAHUB_REPO_URL=https://github.com/thomas-rotszyld-nc/blog_networking_agent_strand
INFRAHUB_REPO_REF=main
